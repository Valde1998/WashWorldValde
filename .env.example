# Kopiér denne fil til .env. .env er ignoreret af Git.
# Brug en NY Google app-adgangskode uden mellemrum; del den aldrig i kode eller chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=din-gmail-adresse@gmail.com
SMTP_APP_PASSWORD=din-nye-app-adgangskode
SMTP_FROM=din-gmail-adresse@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
